{
  "name": "methods",
  "version": "1.1.2",
  "description": "HTTP methods that node supports",
  "keywords": [
    "http",
    "methods"
  ],
  "repository": "jshttp/methods",
  "license": "MIT",
  "contributors": [
    "Douglas Christopher Wilson <doug@somethingdoug.com>",
    "Jonathan Ong <me@jongleberry.com> (http://jongleberry.com)",
    "TJ Holowaychuk <tj@vision-media.ca> (http://tjholowaychuk.com)"
  ],
  "type": "module",
  "exports": {
    "node": "./dist/index.js",
    "default": "./dist/browser.js"
  },
  "main": "./dist/index.js",
  "browser": "./dist/browser.js",
  "typings": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "ts-scripts build",
    "format": "ts-scripts format",
    "prepare": "ts-scripts install && npm run build",
    "size": "size-limit",
    "specs": "ts-scripts specs",
    "test": "ts-scripts test && npm run size"
  },
  "devDependencies": {
    "@borderless/ts-scripts": "^0.15.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26.6.10",
    "@vitest/coverage-v8": "^5.1.2",
    "size-limit": "^14.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "size-limit": [
    {
      "path": "dist/browser.js",
      "limit": "300 B"
    }
  ],
  "ts-scripts": {
    "dist": [
      "dist"
    ],
    "project": [
      "tsconfig.build.json"
    ]
  }
}
